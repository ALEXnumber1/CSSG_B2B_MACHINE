{
  // Cloudflare Worker that will replace Vercel: static site from dist/ (built by `npm run build`,
  // prerendered) plus a small script for /api/* and other dynamic routes. See worker/index.js.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cssg-global",
  "account_id": "004489aef040c026483f264cfbc89aa0",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs get dist/404.html with a real 404 status (never the SPA shell with a 200).
    "not_found_handling": "404-page",
    // /consultoria/index.html is served at /consultoria and /consultoria/ redirects there,
    // matching the canonical URLs.
    "html_handling": "drop-trailing-slash",
    // The script runs for every request so it can mark non-production hostnames as noindex.
    "run_worker_first": true
  },
  // Public by design (the same values ship in the frontend bundle and src/lib/supabase.ts).
  // Real secrets (RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY, GEMINI/GROQ keys, CRON_SECRET) are set
  // with `wrangler secret put` and never live in the repo.
  "vars": {
    "VITE_SUPABASE_URL": "https://vqisebdthsowhpfpugrb.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZxaXNlYmR0aHNvd2hwZnB1Z3JiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxNjE2MTAsImV4cCI6MjA5MjczNzYxMH0.9TZZ_6mx7vcaYoaeT5PmH02OrOzad6KMHiBwospgxOw"
  },
  "observability": { "enabled": true }
}
