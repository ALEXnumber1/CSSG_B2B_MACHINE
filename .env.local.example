# Credenciales de Supabase
# Renombra este archivo a .env.local y rellena los datos
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh... (tu clave anon)

# Email Nurturing (Resend)
# ⚠️  IMPORTANTE: Esta clave NO lleva el prefijo VITE_ — vive SOLO en el servidor.
# En Vercel: Settings > Environment Variables > añadir RESEND_API_KEY (sin VITE_)
# En local: el servidor de Vite no la expone al browser, solo las funciones de Vercel la usan
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_... (tu API key de Resend)

# Seguridad del Webhook de Supabase (opcional pero recomendado)
# WEBHOOK_SECRET=un-token-secreto-aleatorio

# Supabase Service Role (solo para funciones de servidor, NUNCA en el frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJh... (tu service_role key)

